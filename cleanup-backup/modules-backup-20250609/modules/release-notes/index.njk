{% extends "../../layouts/base.njk" %}

{% block pageTitle %}
  {{ pageTitle }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Release Notes</h1>
      
      <div class="govuk-notification-banner" role="region" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
            Information
          </h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-body">The Release Notes module is currently under development. This page will display system changes across all academic years.</p>
        </div>
      </div>
      
      {% if releases and releases.length > 0 %}
        <h2 class="govuk-heading-m">Release History</h2>
        
        {% for release in releases %}
          <div class="govuk-summary-card">
            <div class="govuk-summary-card__title-wrapper">
              <h3 class="govuk-summary-card__title">{{ release.name }}</h3>
              <div class="govuk-summary-card__meta">{{ release.date | formatDate }}</div>
            </div>
            <div class="govuk-summary-card__content">
              <p class="govuk-body">{{ release.description }}</p>
              
              {% if release.changes and release.changes.length > 0 %}
                <h4 class="govuk-heading-s">Changes</h4>
                <ul class="govuk-list govuk-list--bullet">
                  {% for change in release.changes %}
                    <li>{{ change }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      
      {% else %}
        <p class="govuk-body">No release notes are currently available. Updates will be shown here as they are published.</p>
      {% endif %}
      
      <p class="govuk-body">
        <a href="/" class="govuk-button">Return to Home</a>
      </p>
    </div>
  </div>
{% endblock %}
