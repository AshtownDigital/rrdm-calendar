{
  "name": "rrdm",
  "version": "1.0.0",
  "description": "Reference Data Management System",
  "main": "server-start.js",
  "scripts": {
    "start": "node server-start.js",
    "dev": "node scripts/dev-tools/start-server.js",
    "dev:mongo": "node scripts/dev-tools/start-server.js --real-db",
    "dev:mock": "node scripts/dev-tools/start-server.js --mock-data",
    "dev:port": "node scripts/dev-tools/start-server.js --port=3001",
    "dev:watch": "node --watch scripts/dev-tools/start-server.js --real-db",
    "dev:watch:mock": "node --watch scripts/dev-tools/start-server.js",
    "staging": "cross-env NODE_ENV=staging node server-start.js",
    "prod": "cross-env NODE_ENV=production node server-start.js",
    "copy-govuk-assets": "node ./scripts/copy-govuk-assets.js || echo 'Asset copy script failed but build will continue'",
    "db:setup": "node ./scripts/setup-local-db.js",
    "db:reset": "node ./scripts/reset-local-db.js",
    "env:switch": "node ./scripts/switch-environment.js",
    "env:dev": "cross-env NODE_ENV=development node ./scripts/switch-environment.js development",
    "env:staging": "cross-env NODE_ENV=staging node ./scripts/switch-environment.js staging",
    "env:prod": "cross-env NODE_ENV=production node ./scripts/switch-environment.js production",
    "test": "jest",
    "test:minimal": "jest --config=jest.minimal.config.js",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "cucumber-js",
    "test:e2e:report": "node ./tests/e2e/support/generate-report.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "standardize": "node ./scripts/standardize-templates.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "base64-url": "^2.3.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "chokidar": "^4.0.3",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "cross-env": "^7.0.3",
    "csrf": "^3.1.0",
    "csrf-tokens": "^2.0.0",
    "csurf": "^1.11.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-session": "^1.17.3",
    "govuk-frontend": "^5.11.0",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "nunjucks": "^3.2.4",
    "nunjucks-date-filter": "^0.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "uid-safe": "^2.1.5",
    "uuid": "^11.1.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@cucumber/cucumber": "^11.3.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@playwright/test": "^1.52.0",
    "@prisma/client": "^6.9.0",
    "axios": "^1.9.0",
    "babel-jest": "^30.0.0-beta.3",
    "chalk": "^5.4.1",
    "css-loader": "^6.7.3",
    "cucumber-html-reporter": "^6.0.0",
    "form-data": "^4.0.2",
    "ioredis": "^5.6.1",
    "jest": "^29.6.2",
    "mini-css-extract-plugin": "^2.7.5",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10",
    "open": "^10.1.2",
    "playwright": "^1.52.0",
    "puppeteer": "^24.9.0",
    "sequelize": "^6.37.7",
    "sinon": "^20.0.0",
    "sinon-chai": "^4.0.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3",
    "webpack": "^5.80.0",
    "webpack-cli": "^6.0.1"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^10.1.4"
  },
  "engines": {
    "node": "18.20.8",
    "npm": "10.8.2"
  }
}
