{% extends "layouts/base-with-nav.njk" %}

{% block title %}Delete Impact Area | RRDM{% endblock %}

{% block navigation %}
  {% include "partials/bcr-navigation.njk" %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Delete impact area</h1>

      <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
          <span class="govuk-warning-text__assistive">Warning</span>
          You are about to permanently delete the impact area <strong>{{ impactArea.name }}</strong>. This action cannot be undone.
        </strong>
      </div>

      <p class="govuk-body">If you are sure you want to delete this impact area, choose <strong>Delete impact area</strong>. Otherwise, choose Cancel.</p>

      <form action="/bcr/impact-areas/delete/{{ impactArea.id }}" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="govuk-button govuk-button--warning" data-module="govuk-button">Delete impact area</button>
        <a href="/bcr/impact-areas" class="govuk-button govuk-button--secondary">Cancel</a>
      </form>
    </div>
  </div>
{% endblock %}
