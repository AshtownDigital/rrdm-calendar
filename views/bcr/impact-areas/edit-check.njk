{% extends "layouts/base-with-nav.njk" %}

{% block title %}Confirm impact area changes | RRDM{% endblock %}

{% block navigation %}
  {% include "partials/bcr-navigation.njk" %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Confirm changes</h1>

      <p class="govuk-body">Check the details before saving.</p>

      <dl class="govuk-summary-list govuk-!-margin-bottom-6">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Name</dt>
          <dd class="govuk-summary-list__value">{{ formData.name }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Description</dt>
          <dd class="govuk-summary-list__value">{{ formData.description | default('') }}</dd>
        </div>
      </dl>

      <form action="/bcr/impact-areas/{{ impactAreaId }}/edit" method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="confirm" value="yes">
        <input type="hidden" name="name" value="{{ formData.name }}">
        <input type="hidden" name="description" value="{{ formData.description }}">

        <button class="govuk-button" data-module="govuk-button">Save changes</button>
        <a href="/bcr/impact-areas/edit/{{ impactAreaId }}" class="govuk-button govuk-button--secondary">Cancel</a>
      </form>
    </div>
  </div>
{% endblock %}
