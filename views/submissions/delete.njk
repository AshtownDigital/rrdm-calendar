{% extends "layouts/base-with-nav.njk" %}

{% block title %}Confirm delete | RRDM{% endblock %}

{% block navigation %}
  {% include "partials/bcr-navigation.njk" %}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-l">Submission {{ submission.recordNumber or submission._id }}</span>
    <h1 class="govuk-heading-xl">Are you sure you want to delete this submission?</h1>

    <p class="govuk-body">This action cannot be undone.</p>

    <form action="/submissions/{{ submission.id }}/delete" method="post">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete</button>
      <a href="/submissions/{{ submission.id }}/details" class="govuk-link govuk-!-margin-left-3">Cancel</a>
    </form>
  </div>
</div>
{% endblock %}
