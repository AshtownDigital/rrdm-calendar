{# Review section #}
<h2 class="govuk-heading-l">Review & BCR Details</h2>
<div class="app-card govuk-!-margin-bottom-6">
  <dl class="govuk-summary-list govuk-summary-list--no-border">
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Review outcome</dt><dd class="govuk-summary-list__value">{{ submission.reviewOutcome or '—' }}</dd></div>
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Review comments</dt><dd class="govuk-summary-list__value">{{ submission.reviewComments or '—' }}</dd></div>
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Reviewed at</dt><dd class="govuk-summary-list__value">{{ submission.reviewedAt | date }}</dd></div>
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">BCR id</dt><dd class="govuk-summary-list__value">{{ submission.bcrId or '—' }}</dd></div>
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">BCR number</dt><dd class="govuk-summary-list__value">{{ submission.bcrNumber or '—' }}</dd></div>
  </dl>
</div>
