{# Details panel content extracted from BCR submissions view template #}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-xl">BCR Submission Details</h1>

          <a class="govuk-tabs__tab" href="/submissions/{{ submission._id }}/dates">BCR Dates</a>
        </li>
        <li class="govuk-tabs__list-item">
          <a class="govuk-tabs__tab" href="/submissions/{{ submission._id }}/workflow">Workflow</a>
        </li>
        <li class="govuk-tabs__list-item">
          <a class="govuk-tabs__tab" href="/submissions/{{ submission._id }}/history">History</a>
        </li>
      </ul>
    </nav>

    {# Actions panel #}
    <div class="app-card govuk-!-margin-bottom-6">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third">
          <h3 class="govuk-heading-m govuk-!-margin-bottom-3">Actions</h3>
          <a href="/submissions/{{ submission._id }}/edit" class="govuk-button govuk-!-margin-right-2">
            Edit Submission
          </a>
        </div>
        <div class="govuk-grid-column-two-thirds">
          <h3 class="govuk-heading-m govuk-!-margin-bottom-3">Status</h3>
          {% if submission.status %}
            <strong class="govuk-tag {% if submission.status == 'Approved' %}govuk-tag--green{% elif submission.status == 'Rejected' %}govuk-tag--red{% else %}govuk-tag--blue{% endif %}">{{ submission.status }}</strong>
          {% else %}
            <span class="govuk-tag govuk-tag--grey">Pending</span>
          {% endif %}
          {% if submission.urgencyLevel %}
            <strong class="govuk-tag {% if submission.urgencyLevel == 'critical' %}govuk-tag--red{% elif submission.urgencyLevel == 'high' %}govuk-tag--yellow{% elif submission.urgencyLevel == 'medium' %}govuk-tag--blue{% else %}govuk-tag--green{% endif %} govuk-!-margin-left-2">Priority: {{ submission.urgencyLevel | title }}</strong>
          {% endif %}
        </div>
      </div>
    </div>
    
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Full name</dt>
          <dd class="govuk-summary-list__value">{{ submission.fullName }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Brief description</dt>
          <dd class="govuk-summary-list__value">{{ submission.briefDescription }}</dd>
        </div>
      </dl>
    </section>
    
    {# Section 2: Submission Metadata #}
    <section class="app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Submission Information</h2>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Submitted By</dt>
          <dd class="govuk-summary-list__value">{{ submission.submittedById?.name or 'Unknown' }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Created Date</dt>
          <dd class="govuk-summary-list__value">{{ submission.createdAt | date }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">Updated Date</dt>
          <dd class="govuk-summary-list__value">{{ submission.updatedAt | date }}</dd>
        </div>
      </dl>
    </section>
    
    {# Section 3: Impact Assessment #}
    <section class="app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Impact Assessment</h2>
      
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
          <h3 class="govuk-heading-s">Business Impact</h3>
          <p class="govuk-body">{{ submission.justification }}</p>
        </div>
      </div>
      
      <div class="govuk-grid-row govuk-!-margin-top-4">
            {% endfor %}
          </ul>
        </div>
      </div>
      {% endif %}
    </section>
    <div class="govuk-tabs" data-module="govuk-tabs">
  <h2 class="govuk-visually-hidden">Submission details tabs</h2>
  <ul class="govuk-tabs__list">
    <li class="govuk-tabs__list-item govuk-tabs__list-item--selected"><a class="govuk-tabs__tab" href="#submission">Submission</a></li>
    <li class="govuk-tabs__list-item"><a class="govuk-tabs__tab" href="#review">Review</a></li>
    <li class="govuk-tabs__list-item"><a class="govuk-tabs__tab" href="#audit">Audit</a></li>
  </ul>

  {# Submission tab #}
  <section id="submission" class="govuk-tabs__panel govuk-!-padding-top-0">
    <h2 class="govuk-visually-hidden">Submission</h2>

    {# Determine tag colours #}
    {% set statusClass = 'govuk-tag--grey' %}
    {% if submission.status %}
      {% if submission.status | lower == 'approved' %}{% set statusClass = 'govuk-tag--green' %}
      {% elif submission.status | lower == 'rejected' %}{% set statusClass = 'govuk-tag--red' %}
      {% elif submission.status | lower == 'pending' %}{% set statusClass = 'govuk-tag--yellow' %}
      {% endif %}
    {% endif %}

    {% set urgencyClass = 'govuk-tag--green' %}
    {% if submission.urgencyLevel %}
      {% if submission.urgencyLevel == 'critical' %}{% set urgencyClass = 'govuk-tag--red' %}
      {% elif submission.urgencyLevel == 'high' %}{% set urgencyClass = 'govuk-tag--yellow' %}
      {% elif submission.urgencyLevel == 'medium' %}{% set urgencyClass = 'govuk-tag--blue' %}
      {% endif %}
    {% endif %}

    {# Basic details #}
    <section class="app-card govuk-!-margin-bottom-6" aria-label="Basic submission details">
      <h3 class="govuk-heading-m govuk-!-margin-bottom-2">Basic details</h3>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Submission code</dt><dd class="govuk-summary-list__value">{{ submission.submissionCode }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Record number</dt><dd class="govuk-summary-list__value">{{ submission.recordNumber }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Status</dt><dd class="govuk-summary-list__value">{{ submission.status }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Urgency level</dt><dd class="govuk-summary-list__value">{{ submission.urgencyLevel }}</dd></div>
        {% if submission.otherUrgencyDescription %}<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Other urgency description</dt><dd class="govuk-summary-list__value">{{ submission.otherUrgencyDescription }}</dd></div>{% endif %}
      </dl>
    </section>

    {# Section 6: Contact information #}
    <section class="app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Submitter / contact</h2>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Full name</dt><dd class="govuk-summary-list__value">{{ submission.fullName }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Email address</dt><dd class="govuk-summary-list__value">{{ submission.emailAddress }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Organisation</dt><dd class="govuk-summary-list__value">{{ submission.organisation or '—' }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Submission source</dt><dd class="govuk-summary-list__value">{{ submission.submissionSource }}</dd></div>
      </dl>
    </section>
</section>

    {# Section 7: Description & justification #}
    <section class="app-card app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Description &amp; justification</h2>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Brief description</dt><dd class="govuk-summary-list__value">{{ submission.briefDescription }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Justification</dt><dd class="govuk-summary-list__value">{{ submission.justification }}</dd></div>
        {% if submission.additionalNotes %}<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Additional notes</dt><dd class="govuk-summary-list__value">{{ submission.additionalNotes }}</dd></div>{% endif %}
      </dl>
    </section>

    {# Section 8: Impact & technical info #}
    <section class="app-card app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Impact &amp; technical information</h2>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Impact areas</dt><dd class="govuk-summary-list__value">{% if submission.impactAreas.length %}<ul class="govuk-list govuk-list--bullet">{% for area in submission.impactAreas %}<li>{{ area }}</li>{% endfor %}</ul>{% else %}—{% endif %}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Affected reference data</dt><dd class="govuk-summary-list__value">{% if submission.affectedReferenceData.length %}<ul class="govuk-list govuk-list--bullet">{% for ref in submission.affectedReferenceData %}<li>{{ ref }}</li>{% endfor %}</ul>{% else %}—{% endif %}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Technical dependencies</dt><dd class="govuk-summary-list__value">{{ submission.technicalDependencies or '—' }}</dd></div>
      </dl>
    </section>

    {# Section 9: Attachments & related documents #}
    <section class="app-card app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Attachments &amp; related documents</h2>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Attachments</dt><dd class="govuk-summary-list__value">{% if submission.attachments.length %}{{ submission.attachments.length }} file(s){% else %}—{% endif %}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Related documents</dt><dd class="govuk-summary-list__value">{% if submission.relatedDocuments.length %}{{ submission.relatedDocuments.length }} document(s){% else %}—{% endif %}</dd></div>
      </dl>
    </section>

    {# Section 10: Review & workflow #}
    <section id="review" class="govuk-tabs__panel app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Review &amp; workflow</h2>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Review outcome</dt><dd class="govuk-summary-list__value">{{ submission.reviewOutcome or '—' }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Review comments</dt><dd class="govuk-summary-list__value">{{ submission.reviewComments or '—' }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Reviewed at</dt><dd class="govuk-summary-list__value">{{ submission.reviewedAt | date }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">BCR number</dt><dd class="govuk-summary-list__value">{{ submission.bcrNumber or '—' }}</dd></div>
      </dl>
    </section>

    {# Section 11: Audit info #}
    <section id="audit" class="govuk-tabs__panel app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">Audit information</h2>
      <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Submitted by</dt><dd class="govuk-summary-list__value">{{ submission.submittedById?.name or '—' }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Created at</dt><dd class="govuk-summary-list__value">{{ submission.createdAt | date }}</dd></div>
        <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Updated at</dt><dd class="govuk-summary-list__value">{{ submission.updatedAt | date }}</dd></div>
        {% if submission.deletedAt %}<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Deleted at</dt><dd class="govuk-summary-list__value">{{ submission.deletedAt | date }}</dd></div>{% endif %}
      </dl>
    </section>

</div> {# end govuk-tabs #}

    {# Section 12: All fields (debug view) #}
    <section class="app-card govuk-!-margin-bottom-6">
      <h2 class="govuk-heading-m">All fields (debug view)</h2>
      <table class="govuk-table">
        <tbody class="govuk-table__body">
          {% for key, value in submission %}
            <tr class="govuk-table__row">
              <th class="govuk-table__header govuk-!-font-weight-regular">{{ key }}</th>
              <td class="govuk-table__cell">
                {# Render arrays nicely; otherwise stringify #}
                {% if value and value.push is defined %}
                  <ul class="govuk-list govuk-list--bullet">
                    {% for item in value %}<li>{{ item }}</li>{% endfor %}
                  </ul>
                {% else %}
                  {{ value }}
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  </div>
</div>
