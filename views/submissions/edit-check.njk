{% extends "layouts/base-with-nav.njk" %}

{% block title %}Check changes | RRDM{% endblock %}

{% block navigation %}
  {% include "partials/bcr-navigation.njk" %}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Check changes before saving</h1>

    <form action="/submissions/{{ submissionId }}/edit" method="post">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="confirm" value="yes">
      {# re-post fields #}
      {% for field, value in formData %}
        <input type="hidden" name="{{ field }}" value="{{ value }}">
      {% endfor %}

      <dl class="govuk-summary-list">
        {% for field, value in formData %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ field | replace("_"," ") | capitalize }}</dt>
          <dd class="govuk-summary-list__value">{{ value }}</dd>
        </div>
        {% endfor %}
      </dl>

      <div class="govuk-button-group govuk-!-margin-top-6">
        <button class="govuk-button" data-module="govuk-button">Confirm and save</button>
        <a href="javascript:history.back()" class="govuk-link">Go back and edit</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
