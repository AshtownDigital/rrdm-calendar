{% extends "layouts/base-with-nav.njk" %}

{% block title %}Check submission details | RRDM{% endblock %}

{% block navigation %}
  {% include "partials/bcr-navigation.njk" %}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Check submission details</h1>

    <form action="/submissions/new" method="post">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="confirm" value="yes">
      {# re-post original form fields as hidden inputs #}
      {# Re-post original form fields as hidden inputs, but skip CSRF/confirm #}
      {% for field, value in formData %}
        {% if field != '_csrf' and field != 'confirm' %}
          <input type="hidden" name="{{ field }}" value="{{ value }}">
        {% endif %}
      {% endfor %}

      <dl class="govuk-summary-list">
        {% for field, value in formData %}
        {% if field != '_csrf' and field != 'confirm' %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ field | replace("_"," ") | capitalize }}</dt>
          <dd class="govuk-summary-list__value">{{ value }}</dd>
        </div>
        {% endif %}
        {% endfor %}
      </dl>

      <div class="govuk-button-group govuk-!-margin-top-6">
        <button class="govuk-button" data-module="govuk-button">Confirm and submit</button>
        <a href="javascript:history.back()" class="govuk-link">Go back and edit</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
