{% extends "../layout.njk" %}

{% block pageTitle %}
  Add New Academic Year - RRDM
{% endblock %}

{% block content %}
<div class="govuk-width-container">
  <main class="govuk-main-wrapper" id="main-content" role="main">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Generate Academic Years</h1>

        {# GOV.UK Error Summary #}
        {% if errors and (errors.general or errors.startYear or errors.numberOfYears) %}
          <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="govuk-error-summary">
            <h2 class="govuk-error-summary__title" id="error-summary-title">
              There is a problem
            </h2>
            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                {% if errors.general %}
                  <li><a href="#">{{ errors.general }}</a></li> {# Link to a general area or first field if no specific field #}
                {% endif %}
                {% if errors.startYear %}
                  <li><a href="#startYear">{{ errors.startYear }}</a></li>{% if errors.numberOfYears %}<li><a href="#numberOfYears">{{ errors.numberOfYears }}</a></li>{% endif %}
                {% endif %}
              </ul>
            </div>
          </div>
        {% endif %}

        <form method="POST" action="/academic-years/bulk-create" novalidate>
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          <div class="govuk-form-group {{ 'govuk-form-group--error' if errors and errors.startYear }}">
            <label class="govuk-label govuk-label--m" for="startYear">
              Start Year
            </label>
            <div id="startYear-hint" class="govuk-hint">
              Enter the first academic year, e.g. 2024. Academic years start on 1 September.
            </div>
            {% if errors and errors.startYear %}
              <span id="startYear-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> {{ errors.startYear }}
              </span>
            {% endif %}
            {# For a date input, GOV.UK often uses day, month, year fields separately for accessibility #}
            {# However, a single type="number" min="1900" max="2100" can be used with appropriate polyfills or if browser support is sufficient #}
            {# For simplicity here, using type="number" min="1900" max="2100", but consider GOV.UK date input component for production #}
            <input class="govuk-input govuk-input--width-10 {{ 'govuk-input--error' if errors and errors.startYear }}" 
                   id="startYear" 
                   name="startYear" 
                   type="number" min="1900" max="2100" 
                   value="{{ values.startYear if values else '' }}" 
                   aria-describedby="startYear-hint {{ 'startYear-error' if errors and errors.startYear else '' }}" 
                   required>
          </div>

          <div class="govuk-form-group {{ 'govuk-form-group--error' if errors and errors.numberOfYears }}">
            <label class="govuk-label govuk-label--m" for="numberOfYears">
              How many academic years?
            </label>
            <div id="numberOfYears-hint" class="govuk-hint">
              Enter a number between 1 and 10.
            </div>
            {% if errors and errors.numberOfYears %}
              <span id="numberOfYears-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> {{ errors.numberOfYears }}
              </span>
            {% endif %}
            <input class="govuk-input govuk-input--width-5 {{ 'govuk-input--error' if errors and errors.numberOfYears }}" 
                   id="numberOfYears" 
                   name="numberOfYears" 
                   type="number" min="1" max="10" 
                   value="{{ values.numberOfYears if values else '' }}" 
                   aria-describedby="numberOfYears-hint {{ 'numberOfYears-error' if errors and errors.numberOfYears else '' }}" 
                   required>
          </div>

          <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">
              Create Academic Year
            </button>
            <a class="govuk-link govuk-link--no-visited-state" href="/academic-years">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </main>
</div>
{% endblock %}
